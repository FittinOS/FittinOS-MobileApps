# Public, non-secret build-time values only (compiled into the app bundle).
# Never put Cashfree / API Sathi / JWT / TURN / SMTP secrets here.
#
# Copy to .env for LOCAL DEVELOPMENT. Expo loads it automatically.

# ---- Local development ------------------------------------------------------
# Opt in to the dev variant: `.dev` application id + cleartext HTTP to a local API.
# Without this line the config is treated as a RELEASE build and refuses to run
# unless every release value below is set.
APP_VARIANT=development

# Backend API base URL including the /api prefix.
#   Android emulator -> local backend:  http://10.0.2.2:4100/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4100/api

# Must match the backend's CASHFREE_ENVIRONMENT (SANDBOX | PRODUCTION).
# The app refuses to open checkout when an order was created against the other one.
EXPO_PUBLIC_CASHFREE_ENVIRONMENT=SANDBOX

# Public web origin, used for legal pages and the public profile preview.
EXPO_PUBLIC_WEB_URL=https://fittinos.com

# ---- Release builds (set in CI / the build environment, NOT in this file) ---
# APP_VARIANT                      leave unset (anything other than "development")
# ANDROID_APPLICATION_ID           permanent Play Store id from the Play Console listing
# IOS_BUNDLE_IDENTIFIER            optional until an iOS build exists
# EXPO_PUBLIC_API_URL              https://<production api host>/api
# EXPO_PUBLIC_CASHFREE_ENVIRONMENT PRODUCTION (or SANDBOX for a sandbox test build)
